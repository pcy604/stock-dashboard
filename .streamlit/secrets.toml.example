# Streamlit Cloud 배포 시 사용할 비밀키 템플릿
# ─────────────────────────────────────────────
# 이 파일은 '예시'다. 실제 값은 절대 여기 적지 말고,
# Streamlit Cloud 대시보드의 Settings → Secrets 에 같은 형식으로 붙여넣는다.
# (로컬에서 secrets로 테스트하려면 이 파일을 secrets.toml 로 복사 후 값 채우기 — gitignore됨)

FRED_KEY = "여기에_FRED_API_키"

# 선택 — 텔레그램 알림을 클라우드에서도 보내려면
TELEGRAM_TOKEN = "여기에_텔레그램_봇토큰"
TELEGRAM_CHAT_ID = "여기에_챗ID"

# 선택 — 종목분석 탭 Finnhub
FINNHUB_KEY = "여기에_finnhub_키"

# ── SEC EDGAR 연락처 (필수 — 미국 재무·공시, 2026-11-22) ──
# SEC 는 연락 가능한 이메일이 담긴 User-Agent 를 요구한다(없으면 403).
# 환경변수 SEC_CONTACT 로도 된다(GitHub Actions 는 secrets.SEC_CONTACT 를 쓴다).
[sec]
contact = "여기에_연락_가능한_이메일"

# ── 구글 로그인 · 테스트 명단 · 사용량 측정 (2026-10-21, access.py) ──
[auth]
redirect_uri = "https://stock-dashboard-dmfvhcig7brge7utl7et5r.streamlit.app/oauth2callback"
cookie_secret = "임의의-긴-문자열-32자-이상"
client_id = "xxxx.apps.googleusercontent.com"
client_secret = "GOCSPX-..."
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

[access]
owner_email = "pcy604604@gmail.com"
open = true
allowed_emails = []
blocked_emails = []

[analytics]
posthog_key = ""
posthog_host = "https://eu.i.posthog.com"

[store]   # 계정별 포트폴리오 암호화 저장 (user_store.py 머리말의 SQL 먼저)
url = "https://xxxx.supabase.co"
key = "service_role 키"
master_key = "임의-긴-문자열 — 바꾸면 기존 저장분을 못 읽는다"
